---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title: string;
	description?: string;
	language?: 'gl' | 'en';
}

const {
	title,
	description = 'Wiki de Muimenta Viva: todo o que precisas para vivir, crear e convivir na aldea.',
	language = 'gl',
} = Astro.props;

const currentPath = Astro.url.pathname;
const languageHref = language === 'en'
	? currentPath.replace(/^\/en(?=\/|$)/, '') || '/'
	: `/en${currentPath === '/' ? '/' : currentPath}`;
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/logo-muimenta-viva.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Muimenta Viva Wiki</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,400&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="sidebar-backdrop" data-close-nav aria-hidden="true"></div>
		<div class="wiki-shell">
			<Sidebar currentPath={currentPath} language={language} />
			<div class="wiki-main">
				<header class="wiki-topbar">
					<a class="wiki-topbar__brand" href={language === 'en' ? '/en/' : '/'}>
						<img src="/logo-muimenta-viva.png" alt="" width="64" height="64" />
						Muimenta Viva Wiki
					</a>
					<button type="button" class="nav-toggle" aria-label={language === 'en' ? 'Open menu' : 'Abrir menú'} aria-expanded="false" aria-controls="wiki-sidebar">
						<span class="nav-toggle-bar"></span>
						<span class="nav-toggle-bar"></span>
						<span class="nav-toggle-bar"></span>
					</button>
				</header>
				<main class="wiki-content">
					<nav class="language-menu" aria-label={language === 'en' ? 'Choose language' : 'Escolle idioma'}>
						<span>{language === 'en' ? 'Language' : 'Idioma'}:</span>
						<a href={language === 'en' ? languageHref : currentPath} aria-current={language === 'gl' ? 'page' : undefined}>Galego</a>
						<span aria-hidden="true">·</span>
						<a href={language === 'en' ? currentPath : languageHref} aria-current={language === 'en' ? 'page' : undefined}>English</a>
					</nav>
					<slot />
				</main>
				<footer class="wiki-footer">
					<p>
						{language === 'en' ? 'Muimenta Viva · bringing life to the village of Carballeda de Avia. Coordinated with Sende and Anceu Coliving.' : 'Muimenta Viva · dinamización da aldea en Carballeda de Avia. Coordinación con Sende e Anceu Coliving.'}
					</p>
					<div class="wiki-footer__institutional">
						<img src="/xunta-galicia.svg" alt="Xunta de Galicia" loading="lazy" />
					</div>
				</footer>
			</div>
		</div>
		<script>
			const toggle = document.querySelector('.nav-toggle');
			const backdrop = document.querySelector('[data-close-nav]');

			function setOpen(open: boolean) {
				document.body.classList.toggle('nav-open', open);
				toggle?.setAttribute('aria-expanded', String(open));
			}

			toggle?.addEventListener('click', () => {
				const open = toggle.getAttribute('aria-expanded') !== 'true';
				setOpen(open);
			});

			backdrop?.addEventListener('click', () => setOpen(false));

			document.querySelectorAll('.wiki-sidebar a').forEach((link) => {
				link.addEventListener('click', () => setOpen(false));
			});
		</script>
	</body>
</html>
