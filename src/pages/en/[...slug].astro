---
import WikiLayout from '../../layouts/WikiLayout.astro';
const pages: Record<string, { title: string; description: string; body: string }> = {
	'como-chegar': { title: 'Getting here', description: 'How to reach Muimenta and settle in.', body: '<p class="lede">A small village is easier to enjoy when you arrive with a little preparation.</p><h2>Where we are</h2><p>Muimenta is in Carballeda de Avia, Ourense. Check the exact address and arrival details with the project team before travelling.</p><h2>On arrival</h2><ul><li>Let the team know you are on your way.</li><li>Meet the local connector and get an orientation of the spaces.</li><li>Read the co-living and cleaning guidelines before settling in.</li></ul>' },
	'casa/convivencia': { title: 'Co-living', description: 'Shared life, privacy and a healthy daily rhythm.', body: '<p class="lede">Good co-living is built from small, clear agreements and mutual care.</p><h2>Spaces and privacy</h2><p>Leave private rooms private, ask before photographing people or spaces, and keep noise considerate.</p><h2>Daily rhythm</h2><p>Balance your own work with the life of the village. Join shared moments without assuming everyone has the same schedule.</p><h2>Flexibility and care</h2><p>Say what you need early, listen to others and bring disagreements to the team before they grow.</p>' },
	'casa/espazos': { title: 'Spaces', description: 'A quick guide to the shared and private spaces.', body: '<p class="lede">Each space has a purpose; using it thoughtfully keeps the village comfortable for everyone.</p><h2>Community kitchen</h2><p>The main space for shared meals, workshops and everyday encounters. Clean as you go.</p><h2>Private module</h2><p>Your quiet, private base. Keep it ventilated and report any issue to the connector.</p><h2>Social centre and coworking</h2><p>The social centre hosts open events; coworking is for focused work. Check availability before planning an activity.</p>' },
	'casa/limpeza': { title: 'Cleaning', description: 'Simple routines for cared-for shared spaces.', body: '<p class="lede">Leave every shared space at least as ready as you found it.</p><h2>Shared spaces</h2><ul><li>Wash and put away what you used.</li><li>Wipe surfaces and take rubbish to the right place.</li><li>Tell the team about anything that needs repair.</li></ul><h2>Events</h2><p>Agree beforehand who sets up and who closes the space.</p>' },
	'vida-diaria/comidas': { title: 'Food', description: 'Meals, kitchens and food agreements.', body: '<p class="lede">Food is a way to meet, but shared meals need clear expectations.</p><h2>Basic principle</h2><p>Say whether a meal is shared, individual or an event. Do not assume that everyone eats together every day.</p><h2>Kitchen and pantry</h2><p>Share the space fairly, label personal food and ask before using anything that is not yours.</p>' },
	'vida-diaria/mobilidade': { title: 'Getting around', description: 'Mobility in the village and its surroundings.', body: '<p class="lede">Muimenta is rural: a little planning makes moving around much easier.</p><h2>In and around the village</h2><p>Walk when you can and ask the connector about local services. Plan trips to nearby towns ahead of time and coordinate shared rides responsibly.</p>' },
	'vida-diaria/muigastromenta': { title: 'MuiGastromenta', description: 'The project’s food and community format.', body: '<p class="lede">MuiGastromenta uses food as a welcoming doorway into the village.</p><h2>What it is</h2><p>A community cooking and gathering format that brings residents, neighbours and visitors around local food.</p><h2>If you are a resident</h2><p>Join with curiosity, ask before taking photos, and help leave the kitchen and relationships in good shape.</p>' },
	'residencias/modelo': { title: 'Residency model', description: 'What a Muimenta Viva residency is and is not.', body: '<p class="lede">A residency is a temporary exchange between a person, the village and the project team.</p><h2>What it is (and is not)</h2><p>It is time to create, learn and contribute locally. It is not a tourist stay or a promise that every idea can be delivered immediately.</p><h2>Coordination</h2><p>Keep the connector informed about your plans, visitors, public activities and anything that affects shared spaces.</p>' },
	'residencias/expectativas': { title: 'Expectations', description: 'What residents and the project can expect from each other.', body: '<p class="lede">Clear expectations make a short stay lighter for everyone.</p><h2>What we expect from you</h2><ul><li>Respect people, spaces and local rhythms.</li><li>Communicate changes early.</li><li>Take part in agreed shared tasks.</li></ul><h2>What you can expect</h2><ul><li>A clear welcome and orientation.</li><li>Access to the agreed spaces and support from the connector.</li></ul>' },
	'comunidade': { title: 'Community', description: 'How Muimenta Viva builds relationships and a sustainable pace.', body: '<p class="lede">The village comes alive through presence, listening and activities that neighbours can make their own.</p><h2>What we seek</h2><ul><li>Active listening and local participation.</li><li>A sustainable rhythm rather than a saturated calendar.</li><li>Positive impact on nearby businesses and associations.</li></ul><h2>Communication</h2><p>Coordinate public activities with the team and document with consent.</p>' },
	'equipo': { title: 'Team and partnerships', description: 'Who makes Muimenta Viva possible.', body: '<p class="lede">A small local presence supported by a wider network.</p><h2>On the ground</h2><p>The local connector welcomes residents, links the project with neighbours and keeps daily logistics moving.</p><h2>Coordination</h2><p>Sende and Anceu Coliving coordinate the programme, communications and residency network.</p>' },
	'antes-de-irte': { title: 'Before you leave', description: 'A closing checklist for your Muimenta Viva stay.', body: '<p class="lede">Close your stay with the same care with which you arrived.</p><h2>Checklist</h2><ul><li>Clean and ventilate the spaces you used.</li><li>Return keys and confirm access with the connector.</li><li>Collect belongings and share agreed files or outputs.</li><li>Confirm permissions for photos, recordings or stories.</li></ul>' },
};
export function getStaticPaths() {
	return ['como-chegar', 'casa/convivencia', 'casa/espazos', 'casa/limpeza', 'vida-diaria/comidas', 'vida-diaria/mobilidade', 'vida-diaria/muigastromenta', 'residencias/modelo', 'residencias/expectativas', 'comunidade', 'equipo', 'antes-de-irte'].map((slug) => ({ params: { slug } }));
}
const page = pages[Astro.params.slug ?? 'como-chegar'] ?? pages['como-chegar'];
---
<WikiLayout language="en" title={page.title} description={page.description}>
	<article class="prose" set:html={`<h1>${page.title}</h1>${page.body}`} />
</WikiLayout>
