		'casa/limpeza',
		'vida-diaria/comidas',
		'vida-diaria/mobilidade',
		'vida-diaria/muigastromenta',
		'residencias/modelo',
		'residencias/expectativas',
		'comunidade',
		'equipo',
		'equipo/melloras',
		'antes-de-irte',
	].map((slug) => ({ params: { slug } }));
}

const page = pages[Astro.params.slug ?? 'como-chegar'] ?? pages['como-chegar'];
