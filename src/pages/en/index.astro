---
import WikiLayout from '../../layouts/WikiLayout.astro';
const links = [
	['/en/como-chegar/', 'Getting here', 'Where Muimenta is and how to orient yourself on arrival.'],
	['/en/casa/convivencia/', 'Co-living', 'Shared spaces, daily rhythms and respect for neighbours.'],
	['/en/casa/espazos/', 'Spaces', 'Community kitchen, private module, social centre and coworking.'],
	['/en/vida-diaria/muigastromenta/', 'Daily life', 'MuiGastromenta and getting around day to day.'],
	['/en/residencias/modelo/', 'Residencies', 'The stay model, local hosts and shared expectations.'],
	['/en/comunidade/', 'Community', 'Meetings, local activation and a sustainable pace.'],
	['/en/equipo/', 'Team and partnerships', 'Who coordinates the project and who we work with.'],
	['/en/antes-de-irte/', 'Before you leave', 'Keys, cleaning, handover and feedback at the end of your stay.'],
];
---
<WikiLayout language="en" title="The project" description="Muimenta Viva Wiki: resident onboarding and a guide to the village project.">
	<article class="prose">
		<h1>Muimenta Viva Wiki</h1>
		<p class="lede">Everything you need to live, create and share life here — and to understand how the project works.</p>
		<p><strong>Muimenta Viva</strong> is the first phase of activating Muimenta (Carballeda de Avia, Ourense). It is a network of rehabilitated spaces, growing connections and a shared effort to bring life back to the village.</p>
		<p>The mission is <strong>social, gastronomic and entrepreneurial activation</strong>: open the spaces, welcome creators, build relationships with neighbours and create the conditions for a future village co-living project.</p>
		<p>On the ground, the project is coordinated by the local connector, together with <strong>Sende</strong> and <strong>Anceu Coliving</strong>.</p>
		<blockquote><p>This wiki is a practical guide for temporary residents and anyone who wants to understand the project without relying on internal documents.</p></blockquote>
		<ul class="home-links">{links.map(([href, title, desc]) => <li><a href={href}><span class="home-links__title">{title}</span><p class="home-links__desc">{desc}</p><span class="home-links__arrow" aria-hidden="true">→</span></a></li>)}</ul>
	</article>
</WikiLayout>
