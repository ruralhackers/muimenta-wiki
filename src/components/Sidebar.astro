---
export interface NavItem {
	href: string;
	label: string;
}

export interface NavGroup {
	label?: string;
	items: NavItem[];
}

export const navGroups: NavGroup[] = [
	{
		items: [{ href: '/', label: 'O proxecto' }],
	},
	{
		items: [{ href: '/como-chegar/', label: 'Como chegar' }],
	},
	{
		label: 'Casa',
		items: [
			{ href: '/casa/convivencia/', label: 'Convivencia' },
			{ href: '/casa/espazos/', label: 'Espazos' },
			{ href: '/casa/limpeza/', label: 'Limpeza' },
		],
	},
	{
		label: 'Vida diaria',
		items: [
			{ href: '/vida-diaria/comidas/', label: 'Comidas' },
			{ href: '/vida-diaria/muigastromenta/', label: 'MuiGastromenta' },
			{ href: '/vida-diaria/mobilidade/', label: 'Mobilidade' },
		],
	},
	{
		label: 'Residencias',
		items: [
			{ href: '/residencias/modelo/', label: 'Modelo' },
			{ href: '/residencias/expectativas/', label: 'Expectativas' },
		],
	},
	{
		items: [{ href: '/comunidade/', label: 'Comunidade' }],
	},
	{
		label: 'Equipo',
		items: [
			{ href: '/equipo/', label: 'Equipo e alianzas' },
			{ href: '/equipo/melloras/', label: 'Melloras en curso' },
		],
	},
	{
		items: [{ href: '/antes-de-irte/', label: 'Antes de irte' }],
	},
];

interface Props {
	currentPath: string;
	language?: 'gl' | 'en';
}

const { currentPath, language = 'gl' } = Astro.props;
const isEnglish = language === 'en';
const labels = isEnglish
	? { aria: 'Wiki navigation', brand: 'Wiki', project: 'The project', arrive: 'Getting here', groups: ['House', 'Daily life', 'Residencies'], community: 'Community', teamGroup: 'Team', team: 'Team and partnerships', improvements: 'Improvements in progress', leave: 'Before you leave', foot: 'Carballeda de Avia · Ourense', publicSite: 'Public website' }
	: { aria: 'Navegación da wiki', brand: 'Wiki', project: 'O proxecto', arrive: 'Como chegar', groups: ['Casa', 'Vida diaria', 'Residencias'], community: 'Comunidade', teamGroup: 'Equipo', team: 'Equipo e alianzas', improvements: 'Melloras en curso', leave: 'Antes de irte', foot: 'Carballeda de Avia · Ourense', publicSite: 'Web pública' };
const prefix = isEnglish ? '/en' : '';
const localizedGroups: NavGroup[] = [
	{ items: [{ href: `${prefix}/`, label: labels.project }] },
	{ items: [{ href: `${prefix}/como-chegar/`, label: labels.arrive }] },
	{ label: labels.groups[0], items: [{ href: `${prefix}/casa/convivencia/`, label: isEnglish ? 'Co-living' : 'Convivencia' }, { href: `${prefix}/casa/espazos/`, label: isEnglish ? 'Spaces' : 'Espazos' }, { href: `${prefix}/casa/limpeza/`, label: isEnglish ? 'Cleaning' : 'Limpeza' }] },
	{ label: labels.groups[1], items: [{ href: `${prefix}/vida-diaria/comidas/`, label: isEnglish ? 'Food' : 'Comidas' }, { href: `${prefix}/vida-diaria/muigastromenta/`, label: 'MuiGastromenta' }, { href: `${prefix}/vida-diaria/mobilidade/`, label: isEnglish ? 'Getting around' : 'Mobilidade' }] },
	{ label: labels.groups[2], items: [{ href: `${prefix}/residencias/modelo/`, label: isEnglish ? 'The model' : 'Modelo' }, { href: `${prefix}/residencias/expectativas/`, label: isEnglish ? 'Expectations' : 'Expectativas' }] },
	{ items: [{ href: `${prefix}/comunidade/`, label: labels.community }] },
	{
		label: labels.teamGroup,
		items: [
			{ href: `${prefix}/equipo/`, label: labels.team },
			{ href: `${prefix}/equipo/melloras/`, label: labels.improvements },
		],
	},
	{ items: [{ href: `${prefix}/antes-de-irte/`, label: labels.leave }] },
];

function normalize(path: string) {
	if (path === '/') return '/';
	return path.endsWith('/') ? path : `${path}/`;
}

function isCurrent(href: string, path: string) {
	return normalize(href) === normalize(path);
}
---

<aside class="wiki-sidebar" id="wiki-sidebar" aria-label={labels.aria}>
	<a class="wiki-brand" href={`${prefix}/`}>
		<img src="/logo-muimenta-viva.png" alt="" width="108" height="108" />
		<span class="wiki-brand__text">
			Muimenta Viva
			<span class="wiki-brand__mark">{labels.brand}</span>
		</span>
	</a>
	<div class="language-switcher" aria-label={isEnglish ? 'Language' : 'Idioma'}>
		<a href={isEnglish ? currentPath.replace(/^\/en(?=\/|$)/, '') || '/' : currentPath} aria-current={!isEnglish ? 'page' : undefined}>GL</a>
		<span aria-hidden="true">·</span>
		<a href={isEnglish ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`} aria-current={isEnglish ? 'page' : undefined}>EN</a>
	</div>
	<nav class="wiki-nav">
		{
			localizedGroups.map((group) => (
				<div class="nav-group">
					{group.label && <p class="nav-group__label">{group.label}</p>}
					<ul>
						{group.items.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={isCurrent(item.href, currentPath) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>
	<p class="wiki-sidebar__foot">
		Carballeda de Avia · Ourense<br />
		<a href="https://muimentaviva.gal" target="_blank" rel="noopener">muimentaviva.gal</a>
	</p>
</aside>
